#!/usr/bin/env python3
"""kitty-care — interactive theme and configuration generator for kitty.

Writes kitty's configuration file without clobbering unrelated settings:
keys that kitty-care does not manage are preserved, and the previous file is
saved as kitty.conf.<timestamp>.bak before every write.

Requires Python 3.11+ (for tomllib). Font browsing uses fc-list from fontconfig.

The color themes and ANSI palettes live in themes.toml and
ansi_palettes.toml next to this script (or in a kitty-care data directory).
"""

import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time
import tomllib

MIN_FONT_SIZE = 6
MAX_FONT_SIZE = 72
DEFAULT_SIZE = 12
DEFAULT_OPACITY = 1.0
CONFIG_NAME = "kitty.conf"
COLOR_KEY = re.compile(r"color(?:[0-9]|1[0-5])$")
MANAGED_KEYS = frozenset({
    "font_family",
    "bold_font",
    "italic_font",
    "bold_italic_font",
    "font_size",
    "background",
    "foreground",
    "background_opacity",
})
COLOR_SUPPORTED = sys.stdout.isatty()


THEMES_FILE = "themes.toml"
PALETTES_FILE = "ansi_palettes.toml"
THEMES_ENV = "KITTY_CARE_THEMES"
PALETTES_ENV = "KITTY_CARE_PALETTES"
HEX_COLOR = re.compile(r"#[0-9a-fA-F]{6}")


class ThemeFileError(Exception):
    """Raised when a themes or palettes file is missing or malformed."""


def _data_directories():
    """Directories searched for data files, most specific first."""
    directories = [os.path.dirname(os.path.realpath(__file__))]
    data_home = os.environ.get("XDG_DATA_HOME")
    if not data_home:
        data_home = os.path.join(os.path.expanduser("~"), ".local", "share")
    directories.append(os.path.join(data_home, "kitty-care"))
    directories.extend(("/usr/local/share/kitty-care", "/usr/share/kitty-care"))
    return directories


def data_paths(name, env_var):
    """Candidate paths for a data file, honoring the environment override."""
    override = os.environ.get(env_var)
    if override:
        return [os.path.expanduser(override)]
    return [os.path.join(directory, name) for directory in _data_directories()]


def find_data_file(name, env_var):
    paths = data_paths(name, env_var)
    for path in paths:
        if os.path.isfile(path):
            return path
    raise ThemeFileError(
        "could not find %s; looked in:\n  %s" % (name, "\n  ".join(paths)))


def _read_file(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return handle.read()
    except OSError as error:
        raise ThemeFileError("%s: %s" % (path, error))


def _tables(text, source):
    try:
        data = tomllib.loads(text)
    except tomllib.TOMLDecodeError as error:
        raise ThemeFileError("%s: invalid TOML: %s" % (source, error))
    for name, entry in data.items():
        if not isinstance(entry, dict):
            raise ThemeFileError("%s: %r must be a table" % (source, name))
    return data


def _hex_color(entry, key, source, name):
    value = entry.get(key)
    if not isinstance(value, str) or not HEX_COLOR.fullmatch(value):
        raise ThemeFileError(
            "%s: %r: %r must be a #rrggbb color" % (source, name, key))
    return "#" + value[1:].lower()


def _hex_colors(entry, key, source, name):
    values = entry.get(key)
    if not isinstance(values, list) or len(values) != 8:
        raise ThemeFileError(
            "%s: %r: %r must be a list of 8 colors" % (source, name, key))
    colors = []
    for value in values:
        if not isinstance(value, str) or not HEX_COLOR.fullmatch(value):
            raise ThemeFileError(
                "%s: %r: %r contains invalid color %r" % (source, name, key, value))
        colors.append("#" + value[1:].lower())
    return tuple(colors)


def parse_themes(text, source="<themes>"):
    themes = {}
    for name, entry in _tables(text, source).items():
        themes[name] = (
            _hex_color(entry, "foreground", source, name),
            _hex_color(entry, "background", source, name),
            _hex_colors(entry, "normal", source, name),
            _hex_colors(entry, "bright", source, name),
        )
    if not themes:
        raise ThemeFileError("%s: no themes defined" % source)
    return themes


def parse_palettes(text, source="<palettes>"):
    palettes = {}
    for name, entry in _tables(text, source).items():
        palettes[name] = (
            _hex_colors(entry, "normal", source, name),
            _hex_colors(entry, "bright", source, name),
        )
    return palettes


def load_themes(path=None):
    path = path or find_data_file(THEMES_FILE, THEMES_ENV)
    return parse_themes(_read_file(path), path)


def load_palettes(path=None):
    path = path or find_data_file(PALETTES_FILE, PALETTES_ENV)
    return parse_palettes(_read_file(path), path)


try:
    THEMES = load_themes()
    THEME_FILE_ERROR = None
except ThemeFileError as error:
    THEMES = {}
    THEME_FILE_ERROR = error

try:
    PALETTES = load_palettes()
    PALETTE_FILE_ERROR = None
except ThemeFileError as error:
    PALETTES = {}
    PALETTE_FILE_ERROR = error


THEME_NAMES = list(THEMES)
PALETTE_NAMES = list(PALETTES)

_fonts = None


class Settings:
    def __init__(self):
        self.theme = -1
        self.palette = -1
        self.font = ""
        self.size = DEFAULT_SIZE
        self.opacity = DEFAULT_OPACITY


# ---------------------------------------------------------------------------
# Paths and config parsing
# ---------------------------------------------------------------------------

def config_path():
    directory = os.environ.get("KITTY_CONFIG_DIRECTORY")
    if not directory:
        base = os.environ.get("XDG_CONFIG_HOME")
        if not base:
            base = os.path.join(os.path.expanduser("~"), ".config")
        directory = os.path.join(base, "kitty")
    return os.path.join(os.path.expanduser(directory), CONFIG_NAME)


def read_config(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as handle:
            return handle.read()
    except FileNotFoundError:
        return None


def parse_values(text):
    values = {}
    for raw in text.splitlines():
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        parts = stripped.split(None, 1)
        if len(parts) == 2:
            values[parts[0]] = parts[1].strip()
    return values


def load_settings(path):
    settings = Settings()
    text = read_config(path)
    if text is None:
        print("No existing config at %s; starting from defaults." % path)
        return settings

    values = parse_values(text)
    background = values.get("background", "").lower()
    foreground = values.get("foreground", "").lower()
    colors = tuple(values.get("color%d" % index, "").lower() for index in range(16))

    for index, (_, (theme_fg, theme_bg, _, _)) in enumerate(THEMES.items()):
        if theme_fg.lower() == foreground and theme_bg.lower() == background:
            settings.theme = index
            break

    if all(colors):
        for index, (normal, bright) in enumerate(PALETTES.values()):
            if colors == tuple(color.lower() for color in normal + bright):
                settings.palette = index
                break

    settings.font = values.get("font_family", "")

    try:
        size = int(values.get("font_size", "").split(".")[0])
    except ValueError:
        size = DEFAULT_SIZE
    if MIN_FONT_SIZE <= size <= MAX_FONT_SIZE:
        settings.size = size

    try:
        opacity = float(values.get("background_opacity", ""))
    except ValueError:
        opacity = DEFAULT_OPACITY
    if 0.0 <= opacity <= 1.0:
        settings.opacity = opacity

    print("\n--- Loaded Config ---")
    print("  Theme:     %s" % (
        THEME_NAMES[settings.theme] if settings.theme >= 0 else "<no match found>"))
    print("  ANSI:      %s" % (
        PALETTE_NAMES[settings.palette] if settings.palette >= 0 else "<no match found>"))
    print("  Font:      %s" % (settings.font or "<not set>"))
    print("  Size:      %d" % settings.size)
    print("  Opacity:   %.2f" % settings.opacity)
    return settings


# ---------------------------------------------------------------------------
# Input helpers
# ---------------------------------------------------------------------------

def ask(label):
    try:
        return input(label)
    except EOFError:
        print()
        raise SystemExit(0)


def ask_int(label, low, high):
    while True:
        raw = ask(label).strip()
        if not raw:
            return None
        try:
            value = int(raw)
        except ValueError:
            print("Enter a whole number between %d and %d, or press Enter to cancel." % (low, high))
            continue
        if low <= value <= high:
            return value
        print("Please enter a number between %d and %d." % (low, high))


def ask_float(label, low, high):
    while True:
        raw = ask(label).strip()
        if not raw:
            return None
        try:
            value = float(raw)
        except ValueError:
            print("Enter a number between %.1f and %.1f, or press Enter to cancel." % (low, high))
            continue
        if low <= value <= high:
            return value
        print("Please enter a number between %.1f and %.1f." % (low, high))


# ---------------------------------------------------------------------------
# Menu
# ---------------------------------------------------------------------------

def swatches(colors):
    if not COLOR_SUPPORTED:
        return ""
    blocks = []
    for color in colors:
        red, green, blue = (int(color[start:start + 2], 16) for start in (1, 3, 5))
        blocks.append("\x1b[48;2;%d;%d;%dm " % (red, green, blue))
    return " " + "".join(blocks) + "\x1b[0m"


def show_menu(settings):
    print()
    print("=== kitty-care — Kitty Configuration Generator ===")
    print()
    print("Target: %s" % config_path())
    print("Current settings:")
    print("  Theme:     %s" % (
        THEME_NAMES[settings.theme] if settings.theme >= 0 else "<not set>"))
    print("  ANSI:      %s" % (
        PALETTE_NAMES[settings.palette] if settings.palette >= 0 else "<not set>"))
    print("  Font:      %s" % (settings.font or "<not set>"))
    print("  Size:      %d" % settings.size)
    print("  Opacity:   %.2f" % settings.opacity)
    print()
    print("[1] Select Theme")
    print("[2] Select ANSI Palette")
    print("[3] Select Font")
    print("[4] Set Font Size")
    print("[5] Set Opacity")
    print("[6] Apply Config")
    print("[7] Load Current Config")
    print("[8] Exit")
    print()


def select_theme(settings):
    print("\n--- Select Theme ---")
    for index, (name, (fg, bg, normal, _)) in enumerate(THEMES.items(), 1):
        print("[%2d] %-24s%s" % (index, name, swatches((bg, fg) + normal)))
    choice = ask_int("\nChoice (Enter to cancel): ", 1, len(THEMES))
    if choice is None:
        print("Cancelled.")
        return
    settings.theme = choice - 1
    print("Theme set to: %s" % THEME_NAMES[settings.theme])


def select_palette(settings):
    print("\n--- Select ANSI Palette ---")
    for index, (name, (normal, bright)) in enumerate(PALETTES.items(), 1):
        print("[%2d] %-24s%s" % (index, name, swatches(normal + bright)))
    print("[%2d] %s" % (len(PALETTES) + 1, "Reset to Theme Default"))
    choice = ask_int("\nChoice (Enter to cancel): ", 1, len(PALETTES) + 1)
    if choice is None:
        print("Cancelled.")
        return
    if choice == len(PALETTES) + 1:
        settings.palette = -1
        print("ANSI palette reset to theme default.")
        return
    settings.palette = choice - 1
    print("ANSI palette set to: %s" % PALETTE_NAMES[settings.palette])


# ---------------------------------------------------------------------------
# Fonts
# ---------------------------------------------------------------------------

def unique_families(text):
    seen = set()
    families = []
    for line in text.splitlines():
        family = line.split(",", 1)[0].strip()
        if family and family.casefold() not in seen:
            seen.add(family.casefold())
            families.append(family)
    return sorted(families, key=str.casefold)


def available_fonts():
    global _fonts
    if _fonts is not None:
        return _fonts
    if shutil.which("fc-list") is None:
        print("\nfc-list was not found; install fontconfig to browse installed fonts.")
        _fonts = []
        return _fonts
    for command in (["fc-list", ":spacing=mono", "family"], ["fc-list", "family"]):
        result = subprocess.run(command, capture_output=True, text=True, check=False)
        if result.returncode == 0:
            _fonts = unique_families(result.stdout)
            if _fonts:
                return _fonts
    _fonts = []
    return _fonts


def select_font(settings):
    fonts = available_fonts()
    if not fonts:
        manual = ask("\nEnter a font family name (q to cancel): ").strip()
        if not manual or manual.casefold() == "q":
            print("Cancelled.")
            return
        settings.font = manual
        print("Font set to: %s" % settings.font)
        return

    search = ask("\nSearch font (Enter for all, q to cancel): ").strip()
    if search.casefold() == "q":
        print("Cancelled.")
        return
    matches = [font for font in fonts if search.casefold() in font.casefold()]
    if not matches:
        print("No fonts match %r." % search)
        return

    print("\nFound %d matching fonts:" % len(matches))
    for index, name in enumerate(matches, 1):
        print("[%d] %s" % (index, name))
    choice = ask_int("\nChoice (Enter to cancel): ", 1, len(matches))
    if choice is None:
        print("Cancelled.")
        return
    settings.font = matches[choice - 1]
    print("Font set to: %s" % settings.font)


def set_font_size(settings):
    print("\n--- Set Font Size ---")
    size = ask_int("Font size (%d-%d, Enter to cancel): " % (MIN_FONT_SIZE, MAX_FONT_SIZE),
                   MIN_FONT_SIZE, MAX_FONT_SIZE)
    if size is None:
        print("Cancelled.")
        return
    settings.size = size
    print("Font size set to: %d" % size)


def set_opacity(settings):
    print("\n--- Set Opacity ---")
    opacity = ask_float("Opacity (0.0-1.0, Enter to cancel): ", 0.0, 1.0)
    if opacity is None:
        print("Cancelled.")
        return
    settings.opacity = opacity
    print("Opacity set to: %.2f" % opacity)


# ---------------------------------------------------------------------------
# Config generation
# ---------------------------------------------------------------------------

def render(existing, settings):
    fg, bg, normal, bright = THEMES[THEME_NAMES[settings.theme]]
    if settings.palette >= 0:
        normal, bright = PALETTES[PALETTE_NAMES[settings.palette]]

    kept = []
    for raw in (existing or "").splitlines():
        stripped = raw.strip()
        if stripped in ("# Generated by kitty-care", "# Generated by kitty-conf"):
            continue
        if stripped and not stripped.startswith("#"):
            key = stripped.split(None, 1)[0]
            if key in MANAGED_KEYS or COLOR_KEY.match(key):
                continue
        kept.append(raw)

    while kept and not kept[-1].strip():
        kept.pop()

    block = [
        "# Generated by kitty-care",
        "font_family %s" % settings.font,
        "font_size %d" % settings.size,
        "",
        "background %s" % bg,
        "foreground %s" % fg,
    ]
    block.extend("color%d %s" % (index, color) for index, color in enumerate(normal))
    block.extend("color%d %s" % (index + 8, color) for index, color in enumerate(bright))
    block.extend(["", "background_opacity %.2f" % settings.opacity])

    lines = kept + ([""] if kept else []) + block
    return "\n".join(lines) + "\n"


def backup_path(path):
    timestamp = time.strftime("%Y%m%d-%H%M%S")
    candidate = "%s.%s.bak" % (path, timestamp)
    counter = 1
    while os.path.exists(candidate):
        candidate = "%s.%s-%d.bak" % (path, timestamp, counter)
        counter += 1
    return candidate


def write_config(settings):
    if settings.theme < 0:
        print("\nError: no theme selected. Choose one with menu option 1.")
        return False
    if not settings.font:
        print("\nError: no font selected. Choose one with menu option 3.")
        return False

    path = config_path()
    target = os.path.realpath(path)
    existing = read_config(target)
    text = render(existing, settings)
    directory = os.path.dirname(target) or "."
    os.makedirs(directory, exist_ok=True)

    backup = None
    if existing is not None:
        backup = backup_path(target)
        shutil.copy2(target, backup)

    handle, temporary = tempfile.mkstemp(prefix=".%s." % CONFIG_NAME, dir=directory)
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        mode = stat.S_IMODE(os.stat(target).st_mode) if existing is not None else 0o644
        os.chmod(temporary, mode)
        os.replace(temporary, target)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise

    print("\nConfig written to: %s" % target)
    if target != path:
        print("Symlink preserved: %s" % path)
    if backup:
        print("Previous config saved as: %s" % backup)
    print("\nRestart kitty or reload the config with ctrl+shift+f5.")
    return True


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def print_help():
    print("Usage: kitty-care")
    print()
    print("Interactive generator for kitty's configuration file:")
    print("  $KITTY_CONFIG_DIRECTORY/kitty.conf")
    print("  ${XDG_CONFIG_HOME:-~/.config}/kitty/kitty.conf")
    print()
    print("Options:")
    print("  -h, --help    Show this help message")
    print()
    print("The menu lets you:")
    print("  - Select from %d color themes" % len(THEMES))
    print("  - Select from %d ANSI color palettes, or the theme's own colors" % len(PALETTES))
    print("  - Search installed monospace fonts (via fc-list)")
    print("  - Set the font size (%d-%d)" % (MIN_FONT_SIZE, MAX_FONT_SIZE))
    print("  - Set the background opacity (0.0-1.0)")
    print("  - Write the config")
    print()
    print("Existing settings that kitty-care does not manage are preserved,")
    print("and the previous file is saved as kitty.conf.<timestamp>.bak.")


def main(argv):
    if len(argv) > 1 and argv[1] in ("-h", "--help"):
        print_help()
        return 0
    if len(argv) > 1:
        print("kitty-care: unknown argument %r" % argv[1], file=sys.stderr)
        print("Usage: kitty-care [--help]", file=sys.stderr)
        return 2

    errors = [error for error in (THEME_FILE_ERROR, PALETTE_FILE_ERROR)
              if error is not None]
    if errors:
        for error in errors:
            print("kitty-care: %s" % error, file=sys.stderr)
        return 1

    print("kitty-care — Kitty Configuration Generator")
    print("==========================================")
    path = config_path()
    settings = load_settings(path)

    while True:
        show_menu(settings)
        raw = ask("Choice (1-8, Enter to exit): ").strip()
        if not raw:
            print("\nSayonara, goodbye!")
            return 0
        try:
            choice = int(raw)
        except ValueError:
            print("Invalid input. Please enter a number.")
            continue
        if not 1 <= choice <= 8:
            print("Invalid choice. Please select 1-8.")
            continue

        if choice == 1:
            select_theme(settings)
        elif choice == 2:
            select_palette(settings)
        elif choice == 3:
            select_font(settings)
        elif choice == 4:
            set_font_size(settings)
        elif choice == 5:
            set_opacity(settings)
        elif choice == 6:
            if write_config(settings):
                return 0
        elif choice == 7:
            settings = load_settings(path)
        else:
            print("\nSayonara, goodbye!")
            return 0


def cli():
    try:
        result = main(sys.argv)
        sys.stdout.flush()
        return result
    except BrokenPipeError:
        # The reader went away (e.g. `kitty-care --help | head`); stop quietly.
        try:
            devnull = os.open(os.devnull, os.O_WRONLY)
            os.dup2(devnull, sys.stdout.fileno())
        except OSError:
            pass
        return 0
    except KeyboardInterrupt:
        print("\nInterrupted.")
        return 130
    except OSError as error:
        print("kitty-care: %s" % error, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(cli())
